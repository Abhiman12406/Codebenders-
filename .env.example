# Supabase configuration for StudioFlow.
# Copy this file to .env and fill in your project values.
# If these are left empty or as placeholders, the app runs in Guest Demo Mode
# using localStorage. Nothing crashes.
#
# Find both values in the Supabase dashboard under Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
