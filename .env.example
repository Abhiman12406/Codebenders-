# Frontend Configuration (Vercel)
# Render backend URL (e.g., https://studioflow-api.onrender.com). Leave empty in local development to use the Vite proxy.
VITE_API_URL=https://studioflow-api.onrender.com

# Supabase configuration for StudioFlow (Optional - app runs in Offline Guest Demo Mode if empty)
# Find both values in Supabase dashboard under Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend Configuration (Render)
# Render will set PORT automatically. Set CLIENT_URL to your Vercel deployment URL for CORS protection.
PORT=3001
CLIENT_URL=https://your-app.vercel.app
NODE_ENV=production
